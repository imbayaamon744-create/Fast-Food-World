# Copy to .env. Replace the placeholders locally; never commit credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Hosted PostgreSQL provider's direct connection URL, with verified TLS.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST/CHANGE_ME_DATABASE?sslmode=verify-full
# Optional: dedicated hosted TEST database. Never point this at real restaurant data.
TEST_DATABASE_URL=postgresql://CHANGE_ME_TEST_USER:CHANGE_ME_TEST_PASSWORD@CHANGE_ME_TEST_HOST/CHANGE_ME_TEST_DATABASE?sslmode=verify-full
# Generate TWO different values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
TRACKING_SECRET=CHANGE_ME_TRACKING_SECRET
# Direct local app access = 0. Change only for a known reverse proxy topology.
TRUST_PROXY_HOPS=0
