{
  "name": "fast-food-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "tsx watch backend/server/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node backend/dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test backend/tests/unit.test.ts backend/tests/http.test.ts",
    "test:integration": "tsx backend/scripts/test-integration.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config backend/prisma.config.ts",
    "db:seed": "tsx backend/prisma/seed.ts",
    "admin:create": "tsx backend/scripts/create-admin.ts",
    "secrets:check": "node backend/scripts/check-secrets.mjs",
    "test:browser": "playwright test",
    "verify:build": "node backend/scripts/check-frontend.mjs && prisma generate --config backend/prisma.config.ts && tsc --noEmit && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
